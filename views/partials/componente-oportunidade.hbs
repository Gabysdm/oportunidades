<article class="card-lista">
    <div class="card-lista-info">
        <h3>{{this.titulo}}</h3>
        <p>Instituicao: {{this.instituicao}}</p>
        <p>Modalidade: {{this.modalidade}}</p>
    </div>
    <div class="card-lista-acao">
        <!-- Aqui usamos o helper customizado "formatarData" que criamos no app.js -->

        <span class="tag-prazo">Prazo: {{formatarData this.prazo}}</span>
        <a href="/oportunidades/{{this.id}}" class="btn-secundario">Abrir</a>
    </div>
</article>